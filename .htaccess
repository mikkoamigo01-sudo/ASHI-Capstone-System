

RewriteEngine On
RewriteCond %{REQUEST_URI} ^/amaya/admin/backup/ [NC]
RewriteRule ^ - [F,L]

<FilesMatch "\.log$">
  Require all denied
</FilesMatch>

# Covers teacher uploads, assignment uploads, materials, banners, and student submissions
RewriteCond %{REQUEST_URI} ^/amaya/(teacher|student)/(php/)?upload(s)?/ [NC]
RewriteCond %{REQUEST_URI} \.(php\d?|phtml|phar|pl|py|cgi|asp|aspx|sh)$ [NC]
RewriteRule ^ - [F,L]

Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>